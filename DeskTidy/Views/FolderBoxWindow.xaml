<Window x:Class="DeskTidy.Views.FolderBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="240" Height="320" MinWidth="230" MinHeight="180"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        AllowDrop="True" Drop="Window_Drop" DragEnter="Window_DragOver" DragOver="Window_DragOver"
        FontFamily="Microsoft YaHei">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="IconPanel">
            <WrapPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListPanel">
            <VirtualizingStackPanel Orientation="Vertical"/>
        </ItemsPanelTemplate>
        <DataTemplate x:Key="IconTemplate">
            <StackPanel Width="64" Margin="4" Background="Transparent">
                <Image Source="{Binding Icon}" Width="32" Height="32"
                       Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="11"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ListTemplate">
            <StackPanel Orientation="Horizontal" Margin="4,2" Background="Transparent">
                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="2,0,8,0"
                       Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 缩放热区：AllowsTransparency 窗口对 alpha=0 像素"点击穿透"，必须用 alpha=1 的近似透明色 -->
        <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="#01FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶部分类标签页（RadioButton 样式化） -->
        <Style x:Key="TabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" Padding="9,3" Margin="1,2" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemSelectedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- 圆角卡片：半透明主题色（浅色=白磨砂，深色=深色磨砂） -->
        <Border x:Name="Card" Margin="12" CornerRadius="12" Background="{DynamicResource CardBrush}">
            <Grid>
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="打开所在文件夹" Click="OpenFolder_Click"/>
                    <MenuItem Header="重命名格子" Click="Rename_Click"/>
                    <MenuItem Header="切换视图" Click="ToggleView_Click"/>
                    <MenuItem x:Name="MapFolderMenu" Header="映射到文件夹…" Click="MapFolder_Click"/>
                    <Separator/>
                    <MenuItem x:Name="DeleteBoxMenu" Header="删除格子（文件还原到桌面）" Click="DeleteBox_Click"/>
                </ContextMenu>
            </Grid.ContextMenu>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderBar" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseDown" MouseMove="Header_MouseMove"
                  MouseLeftButtonUp="Header_MouseUp">
                <TextBlock x:Name="TitleText" Text="新建格子"
                           Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="Normal"
                           TextAlignment="Center" VerticalAlignment="Center" Margin="12,0,36,0"
                           IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
                <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,6,0" Style="{StaticResource HeaderButtonStyle}"
                        ToolTip="隐藏面板" Click="Hide_Click"/>
            </Grid>

            <!-- 分类标签栏（仅「桌面整理」格子显示，代码里生成） -->
            <ScrollViewer Grid.Row="1" x:Name="TabBarHost" Visibility="Collapsed"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="TabBar" Orientation="Horizontal"/>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource DividerBrush}"/>

            <ListBox x:Name="ItemsList" Grid.Row="3"
                     Background="Transparent" BorderThickness="0"
                     MouseDoubleClick="Item_DoubleClick"
                     PreviewMouseLeftButtonDown="ItemsList_PreviewMouseLeftButtonDown"
                     PreviewMouseRightButtonDown="ItemsList_PreviewMouseRightButtonDown"
                     PreviewMouseMove="ItemsList_PreviewMouseMove"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="打开" Click="OpenItem_Click"/>
                        <MenuItem Header="在资源管理器中显示" Click="LocateItem_Click"/>
                        <MenuItem Header="重命名" Click="RenameItem_Click"/>
                        <Separator/>
                        <MenuItem x:Name="DeleteItemMenu" Header="删除（移入回收站）" Click="DeleteItem_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}" CornerRadius="6">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemSelectedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            </Grid>
        </Border>

        <!-- 调整大小层：Z 序最高，四边+四角（覆盖卡片外缘，方便抓取） -->
        <Grid Panel.ZIndex="100">
            <Thumb Name="R_Left" Width="16" HorizontalAlignment="Left" Cursor="SizeWE"
                   Style="{StaticResource ResizeThumbStyle}" DragDelta="R_Left_DragDelta" DragCompleted="Resize_Completed"/>
            <Thumb Name="R_Right" Width="16" HorizontalAlignment="Right" Cursor="SizeWE"
                   Style="{StaticResource ResizeThumbStyle}" DragDelta="R_Right_DragDelta" DragCompleted="Resize_Completed"/>
            <Thumb Name="R_Top" Height="16" VerticalAlignment="Top" Cursor="SizeNS"
                   Style="{StaticResource ResizeThumbStyle}" DragDelta="R_Top_DragDelta" DragCompleted="Resize_Completed"/>
            <Thumb Name="R_Bottom" Height="16" VerticalAlignment="Bottom" Cursor="SizeNS"
                   Style="{StaticResource ResizeThumbStyle}" DragDelta="R_Bottom_DragDelta" DragCompleted="Resize_Completed"/>
            <Thumb Name="R_TL" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top"
                   Cursor="SizeNWSE" Style="{StaticResource ResizeThumbStyle}" DragDelta="R_TL_DragDelta" DragCompleted="Resize_Completed"/>
            <Thumb Name="R_TR" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Cursor="SizeNESW" Style="{StaticResource ResizeThumbStyle}" DragDelta="R_TR_DragDelta" DragCompleted="Resize_Completed"/>
            <Thumb Name="R_BL" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Cursor="SizeNESW" Style="{StaticResource ResizeThumbStyle}" DragDelta="R_BL_DragDelta" DragCompleted="Resize_Completed"/>
            <Thumb Name="R_BR" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" Style="{StaticResource ResizeThumbStyle}" DragDelta="R_BR_DragDelta" DragCompleted="Resize_Completed"/>
        </Grid>
    </Grid>
</Window>
