<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="DeskTidy 桌面整理"
           Manufacturer="DeskTidy"
           Version="1.0.0"
           UpgradeCode="7C4E1B2A-9D3F-4A6B-8E21-5F0C7A9B3D41"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="已安装更新版本的 DeskTidy，请先卸载后再安装。" />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DeskTidy" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="DeskTidy" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="DeskTidy 桌面整理" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="1B2C3D4E-5F60-4718-9A2B-3C4D5E6F7081">
        <File Id="DeskTidyExe" Source="publish\DeskTidy.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="StartMenuShortcut" Directory="AppMenuFolder" Guid="2C3D4E5F-6071-4829-8B3C-4D5E6F708192">
      <Shortcut Id="StartMenuLink" Name="DeskTidy 桌面整理"
                Description="桌面文件整理工具"
                Target="[INSTALLFOLDER]DeskTidy.exe" WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\DeskTidy" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="3D4E5F60-7182-493A-9C4D-5E6F708192A3">
      <Shortcut Id="DesktopLink" Name="DeskTidy 桌面整理"
                Description="桌面文件整理工具"
                Target="[INSTALLFOLDER]DeskTidy.exe" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\DeskTidy" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
